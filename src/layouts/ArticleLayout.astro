---
import SiteLayout from './SiteLayout.astro';
import ArrowLink from '~/components/ui/ArrowLink.astro';
import { Image } from 'astro:assets';
import type { ArticleLink } from '~/lib/content';

interface Props {
  title: string; summary?: string | undefined; eyebrow?: string | undefined;
  backHref: string; backLabel: string;
  prev?: ArticleLink | undefined; next?: ArticleLink | undefined;
  /** What one of these is called, for the neighbour labels: "Previous role". */
  noun?: string | undefined;
  /** Set the summary as a quote, attributed to this person. */
  quoteBy?: string | undefined;
}
const { title, summary, eyebrow, backHref, backLabel, prev, next, noun, quoteBy } = Astro.props;
/** No sidebar: one centred column, text and photos sharing both edges. */
const solo = !Astro.slots.has('aside');
const label = (dir: 'Previous' | 'Next') => (noun ? `${dir} ${noun}` : dir);
---
<SiteLayout title={`${title} — Zack Low`} description={summary}>
  <article class:list={{ solo }}>
    <header class="head wrap measure-start">
      <ArrowLink href={backHref} label={backLabel} back />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="title">{title}</h1>
      {summary && (quoteBy
        ? <figure class="quote"><blockquote class="t-21">“{summary}”</blockquote><figcaption class="t-14 muted">{quoteBy}</figcaption></figure>
        : <p class="t-21 muted">{summary}</p>)}
      {/* Links and numbers sit with the title, as on the reference page. */}
      <div class="head-extra"><slot name="head" /></div>
    </header>

    <div class="hero-slot wrap"><slot name="hero" /></div>

    <div class="body wrap">
      <div class="prose"><slot /></div>
      <aside class="side"><slot name="aside" /></aside>
    </div>

    {(prev || next) && (
      /* Previous sits left with ←, next sits right with →, so the arrow keys
         and the layout agree. Each card names its neighbour the way a reader
         knows it, with the one line that tells similar titles apart. */
      <nav class="wrap adjacent" aria-label={noun ? `Other ${noun === 'hobby' ? 'hobbies' : noun + 's'}` : 'More'} data-adjacent>
        {prev ? (
          <a href={prev.href} class="adj prev" rel="prev" data-adj="prev" aria-keyshortcuts="ArrowLeft">
            <span class="dir t-14"><svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>{label('Previous')}</span>
            <span class="who">
              {prev.logo && <Image src={prev.logo} alt="" width={28} height={28} class="logo" />}
              <span class="t-21 name">{prev.title}</span>
            </span>
            {prev.sub && <span class="t-14 muted sub">{prev.sub}</span>}
          </a>
        ) : <span class="adj-gap" aria-hidden="true" />}
        {next ? (
          <a href={next.href} class="adj next" rel="next" data-adj="next" aria-keyshortcuts="ArrowRight">
            <span class="dir t-14">{label('Next')}<svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></span>
            <span class="who">
              {next.logo && <Image src={next.logo} alt="" width={28} height={28} class="logo" />}
              <span class="t-21 name">{next.title}</span>
            </span>
            {next.sub && <span class="t-14 muted sub">{next.sub}</span>}
          </a>
        ) : <span class="adj-gap" aria-hidden="true" />}
        <p class="t-12 keyhint" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> to move between {noun === 'hobby' ? 'hobbies' : noun ? noun + 's' : 'articles'}</p>
      </nav>
    )}
  </article>
</SiteLayout>
<script>
  // ← and → move between neighbouring articles. Ignored while typing, with a
  // modifier held (so browser back/forward shortcuts still work), or when a
  // dialog such as search is open.
  const onKey = (e: KeyboardEvent) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    if (document.querySelector('dialog[open]')) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-adj="${e.key === 'ArrowLeft' ? 'prev' : 'next'}"]`);
    if (link) { e.preventDefault(); link.click(); }
  };
  // The router re-runs this script on every article visit; bind only once.
  // onKey looks the links up at press time, so the first binding stays right.
  const w = window as Window & { __adjKeys?: boolean };
  if (!w.__adjKeys) { w.__adjKeys = true; document.addEventListener('keydown', onKey); }
</script>
<style>
  .head { display: flex; flex-direction: column; gap: var(--s-4); padding-block: var(--s-10) var(--s-6); }
  .head-extra:empty { display: none; }
  .quote {
    margin: var(--s-2) 0 0; padding-left: var(--s-5); border-left: 2px solid var(--border-strong);
    display: flex; flex-direction: column; gap: var(--s-2);
  }
  .quote blockquote { margin: 0; color: var(--ink-2); font-style: italic; }
  .quote figcaption::before { content: '— '; }
  /* One line on a desktop: the title names the page, the outcomes under it
     do the shouting. At 76px it took two or three lines and outweighed them. */
  .title {
    font-size: clamp(30px, 4.2vw, 44px); line-height: 1.1; font-weight: 600;
    letter-spacing: -0.035em; text-wrap: balance;
  }
  .measure-start > .title { max-width: none; }
  .hero-slot:empty { display: none; }
  /* Header across the nav's frame; below it one reading column, with text,
     pictures and tables sharing both edges, and a contents rail beside it. */
  .body {
    display: grid; grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: var(--s-10); align-items: start; padding-block: var(--s-8) var(--s-11);
  }
  .side {
    position: sticky; top: 96px; display: flex; flex-direction: column; gap: var(--s-6);
    max-height: calc(100vh - 120px); overflow-y: auto; overscroll-behavior: contain;
  }
  .side:empty { display: none; }
  /* One column (hobbies): text and photos share both edges, as on the reading
     sites this copies (Linear, Stripe, Vercel all keep images at text width). */
  .solo .wrap { width: min(var(--measure), 100% - var(--gutter) * 2); }
  .solo .body { grid-template-columns: minmax(0, 1fr); }
  .adjacent {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4);
    padding-block: var(--s-8) var(--s-10); border-top: 1px solid var(--border);
  }
  .adj {
    display: flex; flex-direction: column; gap: var(--s-2);
    padding: var(--s-5); border: 1px solid var(--border); border-radius: var(--radius-m);
    color: var(--ink); background: var(--canvas);
    transition: border-color 200ms ease, background-color 200ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .adj.next { align-items: flex-end; text-align: right; }
  .adj:hover { border-color: var(--border-strong); background: var(--subtle); color: var(--ink); }
  .adj:active { transform: scale(0.99); }
  .dir { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); }
  .adj:hover .dir { color: var(--link); }
  .arrow { transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
  .prev:hover .arrow { transform: translateX(-3px); }
  .next:hover .arrow { transform: translateX(3px); }
  .who { display: flex; align-items: center; gap: var(--s-3); }
  .next .who { flex-direction: row-reverse; }
  .logo { width: 28px; height: 28px; border-radius: 6px; object-fit: contain; flex-shrink: 0; }
  .name { text-wrap: balance; }
  .sub { font-variant-numeric: tabular-nums; }
  .keyhint {
    grid-column: 1 / -1; justify-self: center; margin: var(--s-2) 0 0;
    display: none; align-items: center; gap: 4px; color: var(--ink-3);
  }
  .keyhint kbd {
    font-family: var(--font-mono); font-size: 11px; line-height: 1;
    padding: 3px 6px; border-radius: 4px; background: var(--chip-bg);
  }
  /* The keyboard hint only means something where there is a keyboard. */
  @media (hover: hover) and (pointer: fine) { .keyhint { display: inline-flex; } }
  @media (max-width: 640px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj-gap { display: none; }
    .adj.next { align-items: flex-start; text-align: left; }
    .next .who { flex-direction: row; }
  }
  @media (prefers-reduced-motion: reduce) {
    .adj, .arrow { transition: border-color 200ms ease, background-color 200ms ease; }
    .prev:hover .arrow, .next:hover .arrow, .adj:active { transform: none; }
  }
  /* The rail is navigation for a wide screen; below that the text has the room. */
  @media (max-width: 1000px) {
    .body { grid-template-columns: minmax(0, 1fr); padding-top: var(--s-6); }
    .side { display: none; }
  }
</style>
