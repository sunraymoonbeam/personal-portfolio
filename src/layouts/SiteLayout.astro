---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/base.css';
import '../styles/article.css';
import '../styles/cursors.css';
import Header from '~/components/site/Header.astro';
import Footer from '~/components/site/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '~/config/site';
import { getSearchItems } from '~/lib/content';

interface Props {
  title?: string | undefined; description?: string | undefined;
  /** A path under public/ or an absolute URL. Defaults to the shared card. */
  image?: string | undefined; imageAlt?: string | undefined;
  /** 'article' for the case studies and essays; everything else is a website page. */
  type?: 'website' | 'article' | undefined;
  /** The 404 page: no canonical or og:url, since /404/ is not a real URL. */
  noindex?: boolean | undefined;
}
const {
  title = `${site.fullName} — ${site.role}`,
  description = site.description,
  image = '/og.jpg',
  imageAlt = `${site.fullName}: ${site.tagline}`,
  type = 'website',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const isHome = Astro.url.pathname === '/';

/* Structured data. The Person node is what lets a search for his name show a
   rich result; the WebSite node names the site. Only the home page carries
   them, which is where a search engine expects them. */
const jsonLd = isHome && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': `${site.origin}/#person`,
      name: site.fullName, alternateName: site.name, givenName: 'Ren Hwa', familyName: 'Low',
      jobTitle: 'AI Engineer', worksFor: { '@type': 'Organization', name: 'Carro' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Nanyang Technological University' },
      address: { '@type': 'PostalAddress', addressLocality: 'Singapore', addressCountry: 'SG' },
      url: site.origin, image: new URL('/og.jpg', site.origin).href, email: `mailto:${site.email}`,
      sameAs: Object.values(site.socials),
      knowsAbout: ['AI agents', 'Large language models', 'Computer vision', 'Speech processing', 'Python', 'TypeScript'],
    },
    {
      '@type': 'WebSite', '@id': `${site.origin}/#website`,
      url: site.origin, name: site.fullName, inLanguage: 'en', publisher: { '@id': `${site.origin}/#person` },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161618" media="(prefers-color-scheme: dark)" />

    <meta name="author" content={site.fullName} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(image, site.origin).href} />
    <meta property="og:image:alt" content={imageAlt} />
    {image === '/og.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og.jpg' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Cross-document view transitions. The router ships its own
        prefers-reduced-motion query that disables every animation, so there is
        nothing extra to guard here. */}
    <ClientRouter />

    {/* Must run before any stylesheet, or the wrong theme flashes on every load.
        is:inline keeps Astro from bundling and deferring it. Plain JS only. */}
    <script is:inline>
      (function () {
        try {
          const v = localStorage.getItem('theme');
          const dark = v === 'dark' || (v !== 'light' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch { /* private mode: CSS @media fallback covers it */ }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header searchItems={await getSearchItems()} />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      import { initTheme, syncDocument } from '~/scripts/theme';
      import { initCursor } from '~/scripts/cursor';
      import { initMenu } from '~/scripts/menu';
      import { initSearch } from '~/scripts/search';
      import { initFilters } from '~/scripts/filters';
      import { initLightbox } from '~/scripts/lightbox';
      import { initClips } from '~/scripts/clips';
      import { initToc } from '~/scripts/toc';
      import { initContact } from '~/scripts/contact';

      // Before the swapped page paints: the new document has no data-theme, so
      // without this every navigation flashes light.
      document.addEventListener('astro:after-swap', syncDocument);

      // Fires on first load and after every navigation. Each init binds the
      // elements of the page now in the DOM; the router has replaced the old ones.
      const start = () => { initTheme(); initCursor(); initMenu(); initSearch(); initFilters(); initLightbox(); initClips(); initToc(); initContact(); };
      document.addEventListener('astro:page-load', start);
    </script>

    <style>
      .skip {
        position: absolute; left: 50%; translate: -50% -150%;
        z-index: 20; padding: 12px 20px; border-radius: 0 0 12px 12px;
        background: var(--ink); color: var(--canvas);
        transition: translate 150ms ease;
      }
      .skip:focus { translate: -50% 0; color: var(--canvas); }
    </style>
  </body>
</html>
