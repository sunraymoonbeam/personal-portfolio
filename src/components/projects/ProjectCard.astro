---
import ScreenshotFrame from './ScreenshotFrame.astro';
import { yearOf } from '../../lib/date';
import type { Project } from '../../lib/content';

interface Props { entry: Project; }
const { entry } = Astro.props;
const d = entry.data;
const href = d.writeup ? `/projects/${entry.id}` : undefined;
const Tag = href ? 'a' : 'div';
---
{/* Home card: title, year beside it, one line. Nothing else — the detail page
    is one click away and does the explaining. */}
<Tag {...(href ? { href } : {})} class:list={['card', { linked: !!href }]}>
  <ScreenshotFrame title={d.title} src={d.cover} alt={d.coverAlt ?? ''} dim={d.coverDim} />
  <div class="body">
    <div class="head">
      <h3 class="t-21 name">{d.shortTitle ?? d.title}</h3>
      <span class="t-14 small tabular">{yearOf(d.published)}</span>
    </div>
    <p class="t-14 muted">{d.claim}</p>
  </div>
</Tag>
<style>
  .card {
    display: flex; flex-direction: column; gap: var(--s-4); height: 100%;
    padding: var(--s-3); margin: calc(var(--s-3) * -1);
    border-radius: var(--radius-l);
    transition: background-color 180ms ease;
  }
  .linked:hover { background: var(--chip-bg); color: inherit; }
  .linked:hover .name { color: var(--link); }

  .body { display: flex; flex-direction: column; gap: var(--s-2); }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
  .name { font-weight: 600; transition: color 180ms ease; }
</style>
