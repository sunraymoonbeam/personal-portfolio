---
import { Image } from 'astro:assets';
interface Props {
  title?: string; src?: ImageMetadata; alt?: string; dim?: boolean;
  height?: number; eager?: boolean; chrome?: boolean;
}
const { title = '', src, alt = '', dim = false, height = 190, eager = false, chrome = false } = Astro.props;
---
<div class="frame">
  {chrome && <div class="bar" aria-hidden="true">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    {title && <span class="t-12 title">{title}</span>}
  </div>}
  <div class="shot" style={`--h:${height}px`}>
    {src
      ? <Image src={src} alt={alt} class:list={['img', { dim }]} loading={eager ? 'eager' : 'lazy'} />
      : <span class="t-12 muted ph">Screenshot</span>}
  </div>
</div>
<style>
  .frame {
    border: 1px solid var(--border-strong); border-radius: var(--radius-m);
    overflow: hidden; background: var(--canvas);
  }
  .bar {
    height: 38px; display: flex; align-items: center; gap: 8px; padding-inline: 14px;
    background: var(--subtle); border-bottom: 1px solid var(--border);
  }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .r { background: #ff5f57; } .y { background: #febc2e; } .g { background: #28c840; }
  .title { flex-grow: 1; text-align: center; margin-right: 52px; color: var(--ink-3); font-family: var(--font-mono); }
  .shot {
    height: var(--h); display: grid; place-items: center;
    background: var(--surface); overflow: hidden;
  }
  .img { width: 100%; height: 100%; object-fit: cover; }
  /* Dimming is opt-in per image: a bright UI screenshot wants it, a photo does not. */
  :root[data-theme='dark'] .img.dim { filter: brightness(0.92); }
</style>
