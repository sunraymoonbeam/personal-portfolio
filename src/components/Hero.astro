---
import { site } from "../data/site";
import HeroScene from "./react/HeroScene.tsx";
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden">
  <!-- 3D island: `client:visible` = hydrate/lazy-load only when on screen.
       Astro renders the static text below with no JS; the WebGL scene is the
       one interactive island. -->
  <div class="absolute inset-0 -z-10 opacity-90">
    <HeroScene client:visible />
  </div>

  <!-- Soft gradient so text stays readable over the 3D. -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-[--color-bg] via-[--color-bg]/40 to-transparent"
  >
  </div>

  <div class="section w-full">
    <p class="mb-4 font-mono text-sm text-[--color-accent-2]">Hi, my name is</p>
    <h1 class="text-5xl font-extrabold leading-tight tracking-tight sm:text-7xl">
      {site.name}.
    </h1>
    <h2 class="mt-2 text-3xl font-bold text-[--color-muted] sm:text-5xl">
      <span class="gradient-text">{site.role}</span>
    </h2>
    <p class="mt-6 max-w-xl text-lg text-[--color-muted]">
      {site.tagline}
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="#projects"
        class="rounded-full bg-[--color-accent] px-6 py-3 text-sm font-medium text-white transition-transform hover:-translate-y-0.5"
      >
        View my work
      </a>
      <a
        href="#contact"
        class="rounded-full border border-[--color-border] px-6 py-3 text-sm font-medium transition-colors hover:border-[--color-accent]"
      >
        Get in touch
      </a>
    </div>
  </div>
</section>
