---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { formatRange, formatDuration } from '../../lib/date';
import type { Work } from '../../lib/content';

interface Props { groups: Array<{ year: string; roles: Work[] }>; }
const { groups } = Astro.props;

const resolved = await Promise.all(
  groups.map(async (g) => ({
    year: g.year,
    roles: await Promise.all(
      g.roles.map(async (r) => ({ entry: r, employer: await getEntry(r.data.employer) })),
    ),
  })),
);
---
<div class="ledger">
  {resolved.map(({ year, roles }) => (
    <section class="group">
      <h2 class="t-28 tabular year">{year}</h2>
      <ol>
        {roles.map(({ entry, employer }) => {
          const d = entry.data;
          const href = d.writeup ? `/work/${entry.id}` : undefined;
          const Tag = href ? 'a' : 'div';
          const current = !d.end;
          return (
            <li>
              {/* Three columns: logo, who, what. The whole row greys on hover,
                  so no separate "read" link is needed to signal it is clickable. */}
              <Tag {...(href ? { href } : {})} class:list={['item', { hoverable: !!href }]}
                   aria-current={current ? 'true' : undefined}>
                <Image src={employer.data.logo} alt="" width={44} height={44} class="logo" loading="lazy" />
                <div class="who">
                  <div class="top">
                    <span class="t-19 role hoverable-title">{d.role}</span>
                    {current && <span class="t-12 present"><span class="dot" aria-hidden="true"></span>Present</span>}
                  </div>
                  <span class="t-14 muted tabular">
                    {employer.data.name} · {d.kind} ·
                    <time datetime={d.start}> {formatRange(d.start, d.end)}</time> · {formatDuration(d.start, d.end)}
                  </span>
                </div>
                <p class="t-14 muted what">{d.summary}</p>
              </Tag>
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</div>
<style>
  .group { display: grid; grid-template-columns: 112px 1fr; gap: var(--s-6); align-items: start; }
  .group + .group { padding-top: var(--s-9); }
  .year { position: sticky; top: 88px; padding-top: var(--s-6); font-weight: 500; }
  li + li { border-top: 1px solid var(--border-strong); }
  .item {
    display: grid; grid-template-columns: 44px minmax(0, 280px) minmax(0, 1fr);
    gap: var(--s-5); align-items: start; padding-block: var(--s-6);
  }
  .logo { border-radius: 10px; object-fit: contain; background: var(--canvas); border: 1px solid var(--border); }
  .who { display: flex; flex-direction: column; gap: 5px; }
  .top { display: flex; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .role { font-weight: 500; }
  .present { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--fill); }
  .what { line-height: 1.5; padding-top: 2px; }
  @media (max-width: 900px) {
    .group { grid-template-columns: 1fr; gap: var(--s-3); }
    .year { position: static; padding-top: 0; }
    .item { grid-template-columns: 44px 1fr; }
    .what { grid-column: 2; }
  }
</style>
