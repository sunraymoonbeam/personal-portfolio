---
import { Image } from 'astro:assets';
import { formatRange, formatDuration } from '~/lib/date';
import { splitEmphasis } from '~/lib/text';

interface Row {
  entry: { id: string; data: Record<string, any> };
  employer: { data: { name: string; logo: ImageMetadata } };
}
/** `compact` drops the bullets and the link: the home page shows the shape of
    a career, not the detail of each role. */
/** The role heading has to sit one level under whatever heading introduces the
    list: h2 on /work/, where the page title is the h1, and h3 on the home page,
    where the section already has an h2. Hard-coding h3 made /work/ skip a
    level six times. */
interface Props { rows: Row[]; compact?: boolean; headingLevel?: 2 | 3 | undefined; }
const { rows, compact = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const words = (t: string) => t.toLowerCase().replace(/[*’']/g, '').split(/\s+/).slice(0, 5).join(' ');
const sameOpening = (a: string, b: string) => words(a) === words(b);
---
{/* Dates and location in a mono rail on the left; role · company, one sentence,
    then bullets on the right. Hovering one role brings it forward and quiets
    the rest, as on the reference page. That is pure CSS via :has(), so it costs
    no JavaScript and simply does nothing on a browser without it. */}
<ol class:list={["list", { compact }]}>
  {rows.map(({ entry, employer }) => {
    const d = entry.data;
    const href = d.writeup ? `/work/${entry.id}` : undefined;
    const current = !d.end;
    return (
      <li class:list={{ linked: !!href }}>
        <article class:list={["row", "rise", { clickable: !!href }]} aria-current={current ? 'true' : undefined}>
          <div class="rail">
            <div class="dates">
              {current && <span class="live" aria-hidden="true"></span>}
              <span class="tabular">{formatRange(d.start, d.end)}</span>
            </div>
            <div class="sub">{formatDuration(d.start, d.end)}</div>
            <div class="sub">{d.location}</div>
          </div>

          {/* The one link in the row. Its ::after covers the whole row, so a
              click anywhere opens the role; the pill is what says so. */}
          {href && (
            <a href={href} class="open" aria-label={`Read about ${d.role} at ${employer.data.name}`}>
              Read
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6" />
              </svg>
            </a>
          )}

          <div class="body">
            <div class="top">
              <Image src={employer.data.logo} alt="" width={32} height={32} class="logo" loading="lazy" />
              <Heading class="t-24 role">{d.role}<span class="at"> · {employer.data.name}</span></Heading>
            </div>
            {/* On the home page a role shows its numbers when it has them: a quick
                skim should leave a figure behind, not just a job title. On
                /work/ the summary is skipped when the first bullet already says
                it, which is how Carro read the same sentence twice. */}
            {compact && d.metrics ? (
              <p class="t-17 muted summary">{d.metrics.map((m: { value: string; label: string }, i: number) => (
                <><strong class="tabular">{m.value}</strong> {m.label}{i < d.metrics.length - 1 ? ', ' : '.'}</>
              ))}</p>
            ) : (!d.bullets?.length || compact || !sameOpening(d.summary, d.bullets[0])) && (
              <p class="t-17 muted summary">{d.summary}</p>
            )}
            {!compact && d.bullets && (
              <ul class="bullets">
                {d.bullets.map((b: string) => (
                  <li class="t-17 muted">
                    <span class="dash" aria-hidden="true"></span>
                    <span>{splitEmphasis(b).map((t) => (t.em ? <strong>{t.text}</strong> : t.text))}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    );
  })}
</ol>
<style>
  .list { display: flex; flex-direction: column; }
  .list > li + li { border-top: 1px solid var(--border); }

  .row {
    position: relative;
    display: grid; grid-template-columns: 190px minmax(0, 1fr) auto;
    gap: var(--s-8); align-items: start;
    padding: var(--s-7) 0;
    transition: opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Without bullets a row is short, so it needs less air around it. */
  .compact .row { padding: var(--s-5) 0; }
  /* Spotlight: the hovered role stays lit and steps forward, the rest recede. */
  /* On the <li>, not the .row: .row runs the scroll-in animation, and an
     animation's opacity and transform beat any hover rule, so the spotlight
     on .row never showed. Only a role that opens dims the rest. */
  .list > li { position: relative; isolation: isolate; transition: opacity 250ms ease; }
  .list:has(li.linked:hover) > li:not(:hover) { opacity: 0.45; }
  /* A soft panel behind the hovered role, bleeding past the column edge, so
     the whole row reads as one target. */
  .linked::before {
    content: ''; position: absolute; inset: 0 calc(var(--s-5) * -1);
    border-radius: var(--radius-l); background: var(--surface);
    opacity: 0; transition: opacity 250ms ease; pointer-events: none; z-index: -1;
  }
  .linked:hover::before { opacity: 1; }
  .linked:hover + li { border-top-color: transparent; }
  .list > li:has(+ .linked:hover) + li { border-top-color: transparent; }

  /*
   * Place all three children explicitly. The Read pill is before .body in the
   * DOM, so with only `grid-column: 3` on it, auto-placement pushed
   * .body onto row 2 column 1 and every role rendered in a 190px ribbon.
   */
  .rail { grid-column: 1; grid-row: 1; }
  .body { grid-column: 2; grid-row: 1; }

  .rail { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; padding-top: 7px; }
  .dates { display: flex; align-items: center; gap: 7px; color: var(--ink); }
  .sub { margin-top: 4px; color: var(--ink-3); font-family: var(--font-sans); font-size: 13px; letter-spacing: -0.01em; }

  /* Quiet pulse on the current role. */
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--fill); flex-shrink: 0; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .live { animation: none; } }

  .body { display: flex; flex-direction: column; gap: var(--s-3); align-items: flex-start; }
  .top { display: flex; align-items: center; gap: var(--s-3); }
  .logo { border-radius: 7px; object-fit: contain; background: var(--canvas); border: 1px solid var(--border); }
  .role { font-weight: 600; }
  .at { color: var(--ink-2); font-weight: 400; }
  .summary { max-width: 62ch; }
  .summary strong { color: var(--ink); font-weight: 600; }

  .bullets { display: flex; flex-direction: column; gap: 10px; margin-top: var(--s-1); }
  .bullets li { display: flex; gap: 12px; max-width: 64ch; line-height: 1.55; }
  .bullets strong { color: var(--ink); font-weight: 600; }
  .dash { margin-top: 13px; width: 12px; height: 1px; flex-shrink: 0; background: var(--fill); opacity: 0.6; }

  /*
   * The Read pill is the row's only link. Its ::after covers the whole row,
   * so clicking anywhere opens the role: one target for a mouse, one name for
   * a screen reader, no nested anchors. It is visible at rest, so a visitor
   * knows the row opens before they hover.
   */
  .clickable { cursor: pointer; }
  .open {
    grid-column: 3; grid-row: 1; align-self: start; justify-self: end; margin-top: 1px;
    display: inline-flex; align-items: center; gap: 4px; height: 30px; padding: 0 10px 0 14px;
    border: 1px solid var(--border); border-radius: var(--radius-pill);
    font-size: 14px; letter-spacing: -0.01em; color: var(--ink-2); white-space: nowrap;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }
  .open::after { content: ''; position: absolute; inset: 0; }
  .open svg { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .clickable:hover .open { color: var(--canvas); background: var(--link); border-color: var(--link); }
  .clickable:hover .open svg { transform: translateX(2px); }
  .clickable:hover .role { color: var(--link); }
  .role { transition: color 200ms ease; }

  @media (max-width: 800px) {
    .row { grid-template-columns: 1fr; gap: var(--s-4); }
    /* One column: rail, body, then the pill, in that order. */
    .rail, .body { grid-column: 1; grid-row: auto; }
    .open { grid-column: 1; grid-row: auto; order: 1; justify-self: start; margin-top: 0; }
    .rail { display: flex; gap: var(--s-4); align-items: baseline; flex-wrap: wrap; }
    .sub { margin-top: 0; }
    .linked::before { inset: 0 calc(var(--s-3) * -1); }
  }
</style>
