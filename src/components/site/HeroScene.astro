---
// The poster is what ships. WebGL only arrives if the section is scrolled to,
// the device can take it, and the user has not asked for reduced motion.
---
<div class="host" data-hero-scene>
  <div data-poster class="poster" aria-hidden="true"></div>
  <canvas hidden aria-hidden="true"></canvas>
</div>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero-scene]');
  if (host) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // @ts-expect-error - saveData is not in every lib.dom
    const saveData = navigator.connection?.saveData === true;
    const small = window.matchMedia('(max-width: 734px)').matches;

    if (!reduced && !saveData && !small) {
      const io = new IntersectionObserver(async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        try {
          const { initHeroScene } = await import('../../scripts/hero-scene');
          initHeroScene(host);
        } catch {
          /* poster stays visible — a failed chunk must not leave a blank box */
        }
      }, { rootMargin: '200px' });
      io.observe(host);
    }
  }
</script>

<style>
  .host { position: relative; aspect-ratio: 16 / 9; width: 100%; }
  .poster, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster {
    border-radius: var(--radius-l);
    background:
      radial-gradient(60% 60% at 62% 42%, color-mix(in oklab, var(--fill) 55%, transparent), transparent 70%),
      var(--surface);
  }
</style>
