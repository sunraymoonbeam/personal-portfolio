---
import { site } from '~/config/site';
import Logo from './Logo.astro';
import CrayonWord from './CrayonWord.astro';
import Search from './Search.astro';

const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href + '/');
const pad = (n: number) => String(n).padStart(2, '0');
---
{/* Geometry copied from the reference header: a 64px bar inside a 1152px
    container, 32px between nav items, 20px in the right-hand cluster. The bar
    is transparent until the page scrolls, then a hairline and blur appear. */}
<header class="header" data-header>
  <nav class="bar" aria-label="Main">
    <a href="/" class="brand" aria-label="Home">
      <Logo size={26} />
      <span class="wordmark">{site.wordmark}</span>
    </a>

    <ul class="links">
      {site.nav.map((l, i) => (
        <li>
          <a href={l.href} class:list={['nav-link', { on: active(l.href) }]}
             aria-current={active(l.href) ? 'page' : undefined}>
            <span class="idx tabular">{pad(i + 1)}</span>
            {l.href === '/hobbies'
              ? <><CrayonWord size={16} /><span class="visually-hidden">Hobbies</span></>
              : l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="cluster">
      <Search />
      <a href="/cv" class:list={['quiet', { on: active('/cv') }]}>CV</a>
      <a href="/contact" class="cta">Contact</a>
      <button type="button" class="burger" data-menu-toggle
              aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </nav>

  <div class="sheet" id="mobile-menu" data-menu hidden>
    <ul>
      {site.nav.map((l, i) => (
        <li>
          <a href={l.href} class:list={['sheet-link', { on: active(l.href) }]}>
            <span class="idx tabular">{pad(i + 1)}</span>{l.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/cv" class:list={['sheet-link', { on: active('/cv') }]}>
          <span class="idx tabular">{pad(site.nav.length + 1)}</span>CV
        </a>
      </li>
    </ul>
    <a href="/contact" class="cta sheet-cta">Contact</a>
  </div>
</header>

<style>
  /*
   * The bar fades its background in over the first 60px of scroll.
   *
   * This used to be a scroll listener setting a class. That broke the moment
   * the router started swapping pages: the listener belonged to the first
   * document and the class went stale, leaving a transparent bar with the page
   * running underneath it. CSS has no such lifetime.
   *
   * Without scroll-timeline support the bar simply always has its background,
   * which is the safe direction to fail in.
   */
  .header {
    position: sticky; top: 0; z-index: 40;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  @supports not (backdrop-filter: blur(1px)) { .header { background: var(--canvas); } }

  @supports (animation-timeline: scroll()) {
    .header {
      animation: header-in linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 60px;
    }
    @keyframes header-in {
      from { background-color: transparent; border-bottom-color: transparent; }
      to   { background-color: var(--nav-bg); border-bottom-color: var(--border); }
    }
  }

  .bar {
    display: flex; align-items: center; justify-content: space-between;
    height: 64px; width: min(1152px, 100%);
    margin-inline: auto; padding-inline: var(--gutter);
  }

  .brand { display: flex; align-items: center; gap: 10px; }
  .wordmark { font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }

  /* Nav labels are mono at 12.8px, the reference size, with the index one step down. */
  .links { display: none; align-items: center; gap: 32px; }
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    padding-block: 4px;
    font-family: var(--font-mono); font-size: 12.8px; line-height: 1;
    color: var(--ink-2); transition: color 200ms ease;
  }
  .nav-link:hover, .nav-link.on { color: var(--ink); }
  .idx { font-size: 9.9px; color: var(--ink-3); }
  .nav-link.on .idx, .nav-link:hover .idx { color: var(--link); }

  /* One flourish: a hairline that grows from the left. */
  .nav-link::after {
    content: ''; position: absolute; left: 0; bottom: -2px; height: 1px; width: 100%;
    background: var(--link); transform: scaleX(0); transform-origin: left;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover::after, .nav-link.on::after { transform: scaleX(1); }

  .cluster { display: flex; align-items: center; gap: 20px; }
  .quiet {
    display: none;
    font-family: var(--font-mono); font-size: 12.8px; color: var(--ink-2);
    transition: color 200ms ease;
  }
  .quiet:hover, .quiet.on { color: var(--ink); }

  .cta {
    display: none; align-items: center;
    padding: 8px 16px; border: 1px solid var(--border-strong); border-radius: var(--radius-s);
    font-family: var(--font-mono); font-size: 12.8px; color: var(--ink);
    transition: border-color 300ms ease, color 300ms ease, background-color 300ms ease;
  }
  .cta:hover { border-color: var(--link); color: var(--link); background: var(--mark-bg); }

  /* ── mobile ── */
  .burger {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin-right: -10px;
    background: none; border: 0; color: var(--ink); cursor: pointer;
  }
  .bars { position: relative; display: block; width: 20px; height: 16px; }
  .bars i {
    position: absolute; left: 0; display: block; width: 20px; height: 2px;
    border-radius: 2px; background: currentColor;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
  }
  .bars i:nth-child(1) { top: 2px; }
  .bars i:nth-child(2) { top: 7px; }
  .bars i:nth-child(3) { top: 12px; }
  [aria-expanded='true'] .bars i:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  [aria-expanded='true'] .bars i:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .bars i:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  .sheet {
    border-top: 1px solid var(--border);
    background: var(--nav-bg); backdrop-filter: saturate(180%) blur(20px);
    padding: var(--s-2) var(--gutter) var(--s-4);
  }
  .sheet-link {
    display: flex; align-items: center; gap: 12px; padding-block: 12px;
    font-family: var(--font-mono); font-size: 14px; color: var(--ink-2);
  }
  .sheet-link:hover, .sheet-link.on { color: var(--ink); }
  .sheet-cta { display: flex; justify-content: center; margin-top: var(--s-3); }

  @media (min-width: 880px) {
    .links, .quiet, .cta { display: flex; }
    .burger, .sheet { display: none; }
  }
</style>
