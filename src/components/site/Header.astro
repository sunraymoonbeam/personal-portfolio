---
import { site } from '~/config/site';
import Logo from './Logo.astro';
import CrayonWord from './CrayonWord.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { SearchItem } from '~/lib/search';

interface Props { searchItems: SearchItem[]; }
const { searchItems } = Astro.props;

const path = Astro.url.pathname;
// Links end in a slash (the canonical form); compare both sides without it.
const bare = (p: string) => p.replace(/\/+$/, '');
const active = (href: string) => bare(path) === bare(href) || path.startsWith(bare(href) + '/');
---
{/* A 64px bar across the wide frame, like Dave Evans' site: the wordmark on
    the left, everything else gathered on the right, no boxes. Two groups. Every item in the bar is
    one height (44px, the touch target) and one type size, so they sit on the same line — the
    old mono labels and a 36px search field did not, which made search look
    like it floated above the links. The bar stays transparent until the page
    scrolls, then a hairline and blur appear. */}
<header class="header" data-header>
  <nav class="bar" aria-label="Main">
    <a href="/" class="brand" aria-label="Home">
      <Logo size={26} />
      <span class="wordmark">{site.wordmark}</span>
    </a>

    <div class="right">
    <ul class="links">
      {site.nav.map((l) => (
        <li>
          <a href={l.href} class:list={['nav-link', { on: active(l.href) }]}
             aria-current={active(l.href) ? 'page' : undefined}>
            {l.href === '/hobbies/'
              ? <><CrayonWord size={16} /><span class="visually-hidden">Hobbies</span></>
              : l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="cluster">
      <Search items={searchItems} />
      <a href="/cv/" class:list={['quiet', { on: active('/cv') }]}>CV</a>
      <a href="/contact/" class="cta">Contact</a>
      <span class="theme-wide"><ThemeToggle bare /></span>
      <button type="button" class="burger" data-menu-toggle
              aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="burger-label" aria-hidden="true">Menu</span>
      </button>
    </div>
    </div>
  </nav>

  <div class="sheet" id="mobile-menu" data-menu hidden>
    <ul>
      {site.nav.map((l) => (
        <li>
          <a href={l.href} class:list={['sheet-link', { on: active(l.href) }]}
             aria-current={active(l.href) ? 'page' : undefined}>
            {l.href === '/hobbies/'
              ? <><CrayonWord size={18} /><span class="visually-hidden">Hobbies</span></>
              : l.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/cv/" class:list={['sheet-link', { on: active('/cv') }]}
           aria-current={active('/cv') ? 'page' : undefined}>CV</a>
      </li>
      <li>
        <button type="button" class="sheet-link sheet-search" data-search-open>Search</button>
      </li>
      <li class="sheet-link sheet-theme">
        <span>Theme</span><ThemeToggle />
      </li>
    </ul>
  </div>
</header>

<style>
  /*
   * The bar fades its background in over the first 60px of scroll.
   *
   * This used to be a scroll listener setting a class. That broke the moment
   * the router started swapping pages: the listener belonged to the first
   * document and the class went stale, leaving a transparent bar with the page
   * running underneath it. CSS has no such lifetime.
   *
   * Without scroll-timeline support the bar simply always has its background,
   * which is the safe direction to fail in.
   */
  .header {
    position: sticky; top: 0; z-index: 40;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  @supports not (backdrop-filter: blur(1px)) { .header { background: var(--canvas); } }

  @supports (animation-timeline: scroll()) {
    .header {
      animation: header-in linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 60px;
    }
    @keyframes header-in {
      from { background-color: transparent; border-bottom-color: transparent; }
      to   { background-color: var(--nav-bg); border-bottom-color: var(--border); }
    }
  }

  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-6);
    height: 64px; width: min(1320px, 100% - var(--gutter) * 2);
    margin-inline: auto;
  }
  .right { display: flex; align-items: center; gap: 28px; }

  .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; min-height: 44px; }
  .wordmark { font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }

  /* Sans at 14px: these are the site's sections, not metadata. Mono at 12.8px
     with 01–05 prefixes made them read as labels, and numbered a set that is
     not a sequence. */
  .links { display: none; align-items: center; gap: 28px; }
  .nav-link {
    position: relative; display: inline-flex; align-items: center;
    height: 44px;
    font-size: 14px; letter-spacing: -0.01em; line-height: 1;
    color: var(--ink-2); transition: color 160ms ease;
  }
  .nav-link:hover, .nav-link.on { color: var(--ink); }

  /* One flourish: a hairline that grows from the left. */
  .nav-link::after {
    content: ''; position: absolute; left: 0; bottom: 9px; height: 1px; width: 100%;
    background: var(--link); transform: scaleX(0); transform-origin: left;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover::after, .nav-link.on::after { transform: scaleX(1); }

  .cluster { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .quiet {
    display: none; align-items: center; height: 44px;
    font-size: 14px; letter-spacing: -0.01em; color: var(--ink-2);
    transition: color 160ms ease;
  }
  .quiet:hover, .quiet.on { color: var(--ink); }

  /* Contact is the one item in ink and weight 500; no pill, the type does it. */
  .cta {
    display: none; align-items: center; height: 44px;
    font-size: 14px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
    transition: color 200ms ease;
  }
  .cta:hover { color: var(--link); }

  /* ── mobile ── */
  /*
   * An unlabelled hamburger alone in an otherwise empty bar reads as an icon,
   * not as navigation — visitors reported not knowing there was a menu at all.
   * The word costs 38px and removes the guess.
   */
  .burger {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-width: 44px; height: 44px; padding-inline: 6px; margin-right: -6px;
    background: none; border: 0; color: var(--ink); cursor: pointer;
  }
  .burger-label { font-size: 14px; line-height: 1; }
  .bars { position: relative; display: block; width: 20px; height: 16px; }
  .bars i {
    position: absolute; left: 0; display: block; width: 20px; height: 2px;
    border-radius: 2px; background: currentColor;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
  }
  .bars i:nth-child(1) { top: 2px; }
  .bars i:nth-child(2) { top: 7px; }
  .bars i:nth-child(3) { top: 12px; }
  [aria-expanded='true'] .bars i:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  [aria-expanded='true'] .bars i:nth-child(2) { opacity: 0; }
  [aria-expanded='true'] .bars i:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  .sheet {
    border-top: 1px solid var(--border);
    background: var(--nav-bg); backdrop-filter: saturate(180%) blur(20px);
    padding: var(--s-2) var(--gutter) var(--s-4);
  }
  .sheet-link {
    display: flex; align-items: center; gap: 12px; padding-block: 12px;
    font-size: 17px; letter-spacing: -0.01em; color: var(--ink-2);
    min-height: 48px; border-bottom: 1px solid var(--border);
  }
  .sheet li:last-child .sheet-link { border-bottom: 0; }
  .sheet-search {
    width: 100%; padding-inline: 0; border: 0; border-bottom: 1px solid var(--border);
    background: none; font: inherit; text-align: left; cursor: pointer;
  }
  .sheet-link:hover, .sheet-link.on { color: var(--ink); }
  .sheet-theme { justify-content: space-between; padding-block: 8px; border-bottom: 0; }
  .sheet-theme:hover { color: var(--ink-2); }
  /* On a wide screen the theme switch joins the cluster; on a phone it is in the menu. */
  .theme-wide { display: none; }

  /* Contact is the conversion target; it used to disappear on a phone. */
  .cta { display: flex; }
  /* The word stays at every width: an icon alone was missed. Tighter gaps make room. */
  @media (max-width: 420px) { .cluster { gap: 10px; } }

  @media (min-width: 880px) {
    .links, .quiet, .theme-wide { display: flex; }
    .burger, .sheet { display: none; }
  }
</style>
