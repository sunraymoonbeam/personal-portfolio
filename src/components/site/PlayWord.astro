---
/**
 * A word in the crayon face, one hue per letter from the token rainbow.
 * `size` in px pins it; leaving it out lets the word inherit its context, so it
 * can sit inside a heading without fighting the heading's size.
 */
interface Props { word?: string; size?: number; }
const { word = 'Hobbies', size } = Astro.props;
---
<span class="word" style={size ? `font-size:${size}px` : undefined} aria-hidden="true">
  {[...word].map((c, i) => <span style={`color:var(--hue-${(i % 7) + 1})`}>{c}</span>)}
</span>
<style>
  .word { font-family: var(--font-hand); font-weight: 600; white-space: nowrap; }
</style>
