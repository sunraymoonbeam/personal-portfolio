---
/** The ⌘K panel. It renders the index it is given; lib/content.ts builds it. */
import type { SearchItem } from '~/lib/search';
interface Props { items: SearchItem[]; }
const { items } = Astro.props;
---
<button type="button" class="trigger" data-search-open aria-label="Search">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
  </svg>
  <span class="label">Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="panel" data-search-panel aria-label="Search">
  <div class="top">
    <input type="search" class="input" placeholder="Search the site"
           autocomplete="off" data-search-input aria-label="Search" />
    {/* A phone keyboard has no Escape key, so the way out is a button. */}
    <button type="button" class="close" data-search-close>Close</button>
  </div>
  <ul class="results" data-search-results>
    {items.map((it) => (
      <li data-item data-text={`${it.title} ${it.sub} ${it.group}`.toLowerCase()}>
        <a href={it.href}>
          <span class="t-17 title">{it.title}</span>
          {it.sub && <span class="t-14 muted sub">{it.sub}</span>}
          <span class="t-12 group">{it.group}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="t-14 muted empty" data-search-empty hidden>No matches.</p>
</dialog>


<style>
  /* A button that says what it does. Same 44px height and 14px type as every
     other item in the bar, so it sits on their line; it used to be a 36px
     empty field with the word hidden, which read as an input and floated
     visibly above the nav text. The shortcut rides inside on wide screens. */
  .trigger {
    display: none; align-items: center; gap: 8px;
    height: 44px; padding: 0 6px;
    border: 0; border-radius: var(--radius-s, 8px);
    background: none; color: var(--ink-2);
    font: inherit; font-size: 14px; letter-spacing: -0.01em; line-height: 1;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }
  .trigger:hover { color: var(--ink); background: var(--chip-bg); }
  .trigger:active { transform: scale(0.98); }
  kbd {
    font-family: var(--font-mono); font-size: 11px; line-height: 1;
    padding: 4px 6px; border-radius: 999px;
    background: var(--chip-bg); color: var(--ink-3);
  }
  @media (min-width: 880px) { .trigger { display: inline-flex; } }
  /* Narrow desktop: icon and shortcut only; the label comes back with room. */
  @media (max-width: 1039px) { .trigger .label { display: none; } }

  .panel {
    width: min(560px, 92vw); margin-top: 12vh; padding: 0;
    border: 1px solid var(--border-strong); border-radius: var(--radius-l);
    background: var(--canvas); color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
  }
  .panel::backdrop { background: rgba(0, 0, 0, 0.35); backdrop-filter: blur(3px); }

  .top { display: flex; align-items: center; border-bottom: 1px solid var(--border); }
  .input {
    flex: 1; min-width: 0; box-sizing: border-box; padding: var(--s-5);
    border: 0;
    background: transparent; color: var(--ink);
    font: inherit; font-size: 19px;
  }
  .input:focus { outline: none; }
  .close {
    min-width: 44px; min-height: 44px; margin-right: var(--s-3); padding-inline: 12px;
    border: 0; border-radius: var(--radius-s, 8px); background: transparent;
    color: var(--ink-2); font: inherit; font-size: 14px; cursor: pointer;
  }
  .close:hover { color: var(--ink); background: var(--chip-bg); }

  .results { max-height: 52vh; overflow-y: auto; padding: var(--s-2); }
  .results a {
    display: grid; grid-template-columns: 1fr auto; gap: 2px var(--s-3);
    padding: var(--s-3) var(--s-4); border-radius: var(--radius-s);
  }
  .results a:hover, .results a:focus-visible { background: var(--chip-bg); color: inherit; outline: none; }
  .title { grid-column: 1; }
  .sub { grid-column: 1; }
  .group {
    grid-column: 2; grid-row: 1 / -1; align-self: center;
    font-family: var(--font-mono); color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .empty { padding: var(--s-5); text-align: center; }
</style>
