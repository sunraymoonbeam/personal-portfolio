---
// The theme switch. It sits in the header (in the menu on a phone) and in the
// footer; scripts/theme.ts keeps every copy in step. `bare` drops the ring,
// so in the header it weighs no more than the text links beside it.
interface Props { bare?: boolean; }
const { bare = false } = Astro.props;
---
<button type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" class:list={['toggle', { bare }]}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>
<style>
  .toggle {
    width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border-strong); border-radius: var(--radius-pill);
    background: transparent; color: var(--ink); cursor: pointer;
    transition: background-color 100ms linear;
  }
  .toggle:hover { background: var(--chip-bg); }
  .bare { border-color: transparent; color: var(--ink-2); }
  .bare:hover { color: var(--ink); }
</style>
