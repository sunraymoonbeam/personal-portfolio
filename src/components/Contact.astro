---
import { site } from "../data/site";
---

<section id="contact" class="section reveal text-center">
  <h2 class="mb-4 text-3xl font-bold">
    <span class="font-mono text-[--color-accent-2]">05.</span> Get in touch
  </h2>
  <p class="mx-auto mb-8 max-w-md text-[--color-muted]">
    I'm always happy to talk about AI systems, infrastructure, or a good climb.
    My inbox is open.
  </p>
  <a
    href={`mailto:${site.email}`}
    class="inline-block rounded-full bg-[--color-accent] px-8 py-3 text-sm font-medium text-white transition-transform hover:-translate-y-0.5"
  >
    Say hello
  </a>

  <footer class="mt-24 flex flex-col items-center gap-4 text-sm text-[--color-muted]">
    <div class="flex gap-6">
      <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-[--color-text]">GitHub</a>
      <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[--color-text]">LinkedIn</a>
      <a href={`mailto:${site.email}`} class="hover:text-[--color-text]">Email</a>
    </div>
    <p class="font-mono text-xs">
      Built with Astro · three.js · Tailwind — {site.location}
    </p>
  </footer>
</section>
