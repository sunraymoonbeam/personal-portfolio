---
import { site } from "../data/site";
---

<section id="tech" class="section reveal">
  <h2 class="mb-10 text-3xl font-bold">
    <span class="font-mono text-[--color-accent-2]">03.</span> Tech I use
  </h2>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      site.tech.map((group) => (
        <div class="rounded-2xl border border-[--color-border] bg-[--color-surface] p-5">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[--color-muted]">
            {group.label}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-[--color-border] px-3 py-1 font-mono text-xs">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
