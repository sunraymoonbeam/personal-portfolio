---
import { Image, getImage } from 'astro:assets';

/**
 * One picture in a `Photos` grid.
 *
 * It is an anchor to a larger version, so with no JavaScript a click still
 * opens the full picture. The lightbox in src/scripts/lightbox.ts upgrades
 * that to an overlay. Nothing here depends on the upgrade happening.
 *
 * The shape comes from the grid, not from here.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Only when it says something the picture does not. Most do not need one. */
  caption?: string | undefined;
}
const { src, alt, caption } = Astro.props;
const full = await getImage({ src, width: 1800, format: 'webp' });
---
<figure class="shot">
  <a href={full.src} class="frame" data-lightbox data-alt={alt}
     {...(caption ? { 'data-caption': caption } : {})}>
    <Image src={src} alt={alt} widths={[400, 800, 1200]}
           sizes="(max-width: 640px) 100vw, 400px" class="img" loading="lazy" />
  </a>
  {caption && <figcaption class="t-14 muted">{caption}</figcaption>}
</figure>
<style>
  .shot { margin: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .frame {
    display: block; overflow: hidden; border-radius: var(--radius-s);
    background: var(--surface); cursor: zoom-in;
  }
  .img {
    width: 100%; height: auto; display: block;
    aspect-ratio: var(--shot-ratio, 1 / 1); object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .frame:hover .img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) { .img { transition: none; } }
  figcaption { line-height: 1.45; }
</style>
