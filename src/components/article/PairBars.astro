---
/**
 * Two bars per row, on one true 0–100% scale: what a thing is a share of
 * (grey) against what it costs (accent). The gap between the two is the point.
 * Each bar sits in a full-width track, so 72% is drawn as 72% of the track.
 */
interface Props {
  series: [string, string];
  rows: { label: string; a: number; b: number }[];
  caption?: string | undefined;
}
const { series, rows, caption } = Astro.props;
// MDX props are not checked by the content schema, so a typo like 140 would
// draw a bar past its track. Stop the build instead of drawing a false chart.
for (const r of rows) for (const v of [r.a, r.b]) {
  if (!Number.isFinite(v) || v < 0 || v > 100) throw new Error(`PairBars: "${r.label}" has ${v}, outside 0–100`);
}
const fmt = (v: number) => `${v.toFixed(0)}%`;
---
<figure class="chart">
  <div class="legend t-14" aria-hidden="true">
    <span class="key"><i class="a" />{series[0]}</span>
    <span class="key"><i class="b" />{series[1]}</span>
  </div>
  <dl class="rows">
    {rows.map((r) => (
      <div class="row">
        <dt class="label t-14">{r.label}</dt>
        <dd class="pair" aria-label={`${series[0]} ${fmt(r.a)}, ${series[1]} ${fmt(r.b)}`}>
          <span class="line"><span class="track"><span class="bar a" style={`width:${r.a}%`} /></span><b class="tabular">{fmt(r.a)}</b></span>
          <span class="line"><span class="track"><span class="bar b" style={`width:${r.b}%`} /></span><b class="tabular hot">{fmt(r.b)}</b></span>
        </dd>
      </div>
    ))}
  </dl>
  {caption && <figcaption class="t-14 small cap">{caption}</figcaption>}
</figure>
<style>
  .chart {
    margin: var(--s-8) 0; padding: var(--s-6);
    border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--subtle);
  }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 var(--s-5); color: var(--ink-2); }
  .legend .key { display: inline-flex; align-items: center; gap: 7px; }
  .legend i { display: block; width: 10px; height: 10px; border-radius: 3px; }
  .rows { display: flex; flex-direction: column; gap: 18px; margin: 0; }
  .row { display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: center; gap: 12px; }
  .label { color: var(--ink); }
  .pair { display: flex; flex-direction: column; gap: 5px; margin: 0; }
  .line { display: grid; grid-template-columns: minmax(0, 1fr) 40px; align-items: center; gap: 10px; }
  /* The faint track is the 100% mark, so the scale is visible without an axis. */
  .track { display: block; min-width: 0; border-radius: 4px; background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .bar { display: block; height: 16px; border-radius: 4px; }
  .line b { font-size: 13px; font-weight: 500; color: var(--ink-2); text-align: right; }
  .line b.hot { color: var(--hue-1); font-weight: 600; }
  .a { background: color-mix(in srgb, var(--ink) 22%, transparent); }
  .b { background: var(--hue-1); }
  .cap { margin-top: var(--s-5); }
  @media (max-width: 520px) {
    .chart { padding: var(--s-4); }
    .row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
