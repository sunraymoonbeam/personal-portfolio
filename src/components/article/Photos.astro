---
/**
 * A block of photographs inside an article. Every block on the site has the
 * same shape: two across, one shared crop, a tight gap, the same width as the
 * text. A single photo spans the column in a wider crop. Consistency is the
 * whole effect, so the shape is fixed here rather than chosen per block.
 */
---
<figure class="photos"><div class="grid"><slot /></div></figure>
<style>
  .photos { margin: var(--s-8) 0; }
  .grid { display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); --shot-ratio: 4 / 5; }
  .grid:has(> :only-child) { grid-template-columns: minmax(0, 1fr); --shot-ratio: 3 / 2; }
  @media (max-width: 420px) { .grid { gap: 6px; } }
</style>
