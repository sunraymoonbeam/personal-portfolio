---
import { Image } from 'astro:assets';
interface Props {
  src: ImageMetadata; alt: string; caption?: string;
  dim?: boolean;
}
const { src, alt, caption, dim = false } = Astro.props;
---
<figure class="fig">
  <Image src={src} alt={alt} widths={[600, 900, 1400]}
         sizes="(max-width: 734px) 100vw, 660px"
         class:list={['img', { dim }]} loading="lazy" />
  {caption && <figcaption class="t-14 small">{caption}</figcaption>}
</figure>
<style>
  .fig { margin: 0; display: flex; flex-direction: column; gap: var(--s-3); }
  .img { width: 100%; border-radius: var(--radius-m); aspect-ratio: 16 / 10; object-fit: cover; }
  /* The sidebar shares this grid row; figures stay in the reading column. */
  .fig { max-width: 100%; min-width: 0; }
  :root[data-theme='dark'] .img.dim { filter: brightness(0.92); }
</style>
