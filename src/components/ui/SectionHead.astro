---
/**
 * `title` and `sub` cover the plain case. The matching slots take over when the
 * text needs markup inside it, e.g. a coloured word or an inline code span.
 */
interface Props { title?: string; sub?: string; href?: string; linkLabel?: string; }
const { title, sub, href, linkLabel } = Astro.props;
const hasSub = sub !== undefined || Astro.slots.has('sub');
---
<div class="head rise">
  <div class="stack">
    <h2 class="t-48">{title}<slot name="title" /></h2>
    {hasSub && <p class="t-21 muted sub">{sub}<slot name="sub" /></p>}
  </div>
  {href && (
    <a href={href} class="link-arrow">
      {linkLabel}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 6l6 6-6 6" />
      </svg>
    </a>
  )}
</div>
<style>
  .head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--s-8); padding-bottom: var(--s-9); flex-wrap: wrap;
  }
  .stack { gap: var(--s-3); }
  .sub { max-width: 560px; }
  /* Stacked on a phone: the link sits under the subtitle, so the heading
     needs far less air before the first card than it does beside it. */
  @media (max-width: 640px) { .head { gap: var(--s-4); padding-bottom: var(--s-7); } }
</style>
