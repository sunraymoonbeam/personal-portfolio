---
import { Image } from 'astro:assets';
import SiteLayout from '~/layouts/SiteLayout.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import ProjectGrid from '~/components/projects/ProjectGrid.astro';
import WorkList from '~/components/work/WorkList.astro';
import CrayonWord from '~/components/site/CrayonWord.astro';
import HobbyGrid from '~/components/hobbies/HobbyGrid.astro';
import TechChip from '~/components/ui/TechChip.astro';
import portrait from '~/assets/portrait.jpg';
import { home } from '~/copy/home';
import { pages } from '~/copy/pages';
import { site } from '~/config/site';
import { STACK_GROUPS } from '~/data/technologies';
import {
  getPublishedProjects, getWorkRows, selectFeatured, resolveWork, getHobbiesIndex,
} from '~/lib/content';

const projects = selectFeatured(await getPublishedProjects(), 3);
const roles = await Promise.all((await getWorkRows()).slice(0, 3).map(resolveWork));
const hobbies = (await getHobbiesIndex()).slice(0, 3);
---
<SiteLayout>
  <section class="hero wrap">
    <div class="copy">
      <h1 class="name"><span class="given">Ren Hwa</span> <span class="nick">(Zack)</span> <span class="family">Low</span></h1>
      <p class="t-24 role">{home.role}</p>
      {home.lede.map((para) => (
        <p class="t-19 muted lede">
          {para.map((part) => {
            if ('hi' in part && part.hi) return <strong class="hi">{part.text}</strong>;
            if ('em' in part && part.em) return <strong>{part.text}</strong>;
            return part.text;
          })}
        </p>
      ))}
    </div>
    <div class="art">
      <Image src={portrait} alt="Ren Hwa (Zack) Low" widths={[400, 700, 1000]}
             sizes="(max-width: 900px) 70vw, 380px" loading="eager" />
      {/* The arrow points back up at the photo, so the label reads as a caption
          for it rather than as a hint to keep scrolling. */}
      <a href="/about" class="more pop t-14">
        <svg class="bob" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" /><path d="M6 11l6-6 6 6" />
        </svg>
        More about me
      </a>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <SectionHead {...home.sections.projects} href="/projects" linkLabel="All projects" />
      <ProjectGrid entries={projects} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead {...home.sections.work} href="/work" linkLabel="All roles" />
      {/* Same rows as /work, without the bullets: the shape, not the detail. */}
      <WorkList rows={roles} compact />
    </div>
  </section>

  <section class="section band" id="skills">
    <div class="wrap">
      <SectionHead {...home.sections.skills} href="/skills" linkLabel="All skills" />
      <div class="groups">
        {STACK_GROUPS.map((g) => (
          <div class="group">
            <h3 class="t-21">{g.title}</h3>
            <ul class="chips">{g.items.map((id) => <TechChip id={id} />)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead {...home.sections.hobbies} href="/hobbies" linkLabel="View all hobbies">
        <CrayonWord slot="title" />
        <Fragment slot="sub">Because there is more to life than <code>git push</code>.</Fragment>
      </SectionHead>
      <HobbyGrid items={hobbies} />
    </div>
  </section>

  <section class="section band closing">
    <div class="wrap inner">
      <h2 class="t-48">{pages.contact.title}</h2>
      <blockquote class="pitch">
        {pages.contact.lede.map((line) => <p class="t-19">{line}</p>)}
      </blockquote>
      <a href="/contact" class="btn">{home.cta.action}</a>
      <a href={`mailto:${site.email}`} class="t-14 small">{site.email}</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    gap: var(--s-10); align-items: center;
    padding-block: clamp(48px, 7vw, 88px);
  }
  .copy { display: flex; flex-direction: column; gap: var(--s-4); }

  /* The one place a gradient is allowed: his name. */
  .name {
    margin: 0;
    font-size: clamp(38px, 5vw, 62px); line-height: 1.06;
    font-weight: 600; letter-spacing: -0.042em;
    text-wrap: balance;
    background: linear-gradient(100deg, var(--ink) 18%, #0071e3 62%, #2997ff 96%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .name .nick { white-space: nowrap; }
  .role { color: var(--ink-2); font-weight: 500; }
  .lede { max-width: 620px; }
  .lede strong { color: var(--ink); font-weight: 600; }
  .lede .hi { color: var(--link); }


  .art { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
  .art img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-l); }
  .more { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-2); }
  .more:hover { color: var(--link); }
  /* The hover lift has to beat the idle hop, so it wins on the element. */
  .more:hover svg { animation: none; transform: translateY(-7px); transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .more { gap: 9px; }

  .groups { display: flex; flex-direction: column; }
  .group {
    display: grid; grid-template-columns: 200px 1fr; gap: var(--s-7);
    align-items: start; padding-block: var(--s-6); border-top: 1px solid var(--border);
  }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  /* The heading is centred; the quote under it keeps its own left edge, so
     the rule down its side still reads as a rule. */
  .closing .inner {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--s-6); text-align: center;
  }
  /* The heading is centred, the quote under it keeps its own left edge so the
     rule down its side still reads as a rule. */
  .pitch {
    display: flex; flex-direction: column; gap: var(--s-4);
    max-width: 56ch; margin: 0; text-align: left;
    padding-left: var(--s-5); border-left: 2px solid var(--link);
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: var(--s-7); }
    .art { max-width: 300px; }
    .group { grid-template-columns: 1fr; gap: var(--s-3); }
  }
</style>
