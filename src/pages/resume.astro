---
import { getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../content/pages';
import { getWorkRows, getPublishedProjects } from '../lib/content';
import { formatRange } from '../lib/date';
const roles = await Promise.all((await getWorkRows()).map(async role => ({
  role, employer: await getEntry(role.data.employer),
})));
const projects = await getPublishedProjects();
---
<SiteLayout title="Résumé — Zack Low" description={pages.resume.lede}>
  <section class="section wrap measure-start head">
    <p class="eyebrow">{pages.resume.eyebrow}</p>
    <h1 class="t-48">{pages.resume.title}</h1>
    <p class="t-17 muted">{pages.resume.lede}</p>
    <div class="actions">
      <a href="/resume.pdf" class="btn" download="Ren Hwa Low — Resume.pdf">Download PDF</a>
      <a href="/resume.pdf" class="btn btn-ghost" target="_blank" rel="noopener">Open PDF in a new tab</a>
    </div>
  </section>
  <div class="wrap body">
    <section class="block" aria-labelledby="experience">
      <h2 id="experience" class="t-28">Experience</h2>
      {roles.map(({ role, employer }) => <article class="item">
        <p class="t-14 muted tabular">{formatRange(role.data.start, role.data.end)}</p>
        <div class="what">
          <h3 class="t-21">{role.data.role} · {employer?.data.name}</h3>
          <p>{role.data.summary}</p>
          {role.data.cardHighlights && <ul class="highlights">
            {role.data.cardHighlights.map(item => <li>{item}</li>)}
          </ul>}
          {role.data.writeup && <a class="text-link" href={`/work/${role.id}`}>Read about this role →</a>}
        </div>
      </article>)}
    </section>
    <section class="block" aria-labelledby="education">
      <h2 id="education" class="t-28">Education</h2>
      <div class="item">
        <p class="t-14 muted">Aug 2020 — Jun 2024</p>
        <div class="what">
          <h3 class="t-21">Nanyang Technological University</h3>
          <p>Bachelor of Engineering in Computer Science</p>
        </div>
      </div>
    </section>
    <section class="block" aria-labelledby="projects">
      <h2 id="projects" class="t-28">Projects</h2>
      {projects.map(project => <article class="item">
        <h3 class="t-21">{project.data.title}</h3>
        <div class="what">
          <p>{project.data.summary}</p>
          {project.data.writeup && <a class="text-link" href={`/projects/${project.id}`}>Read the build →</a>}
        </div>
      </article>)}
    </section>
  </div>
</SiteLayout>
<style>
  .head, .body, .block, .what { display: flex; flex-direction: column; }
  .head { gap: var(--s-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .body { gap: var(--s-9); padding-bottom: var(--s-10); }
  .block { gap: var(--s-5); }
  .item { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--s-6); padding-top: var(--s-5); border-top: 1px solid var(--border); }
  .what { gap: var(--s-3); }
  .highlights { list-style: disc; padding-left: var(--s-5); }
  @media (max-width: 734px) { .item { grid-template-columns: 1fr; gap: var(--s-3); } }
</style>
