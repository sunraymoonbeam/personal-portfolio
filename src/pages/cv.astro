---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { pages } from '~/copy/pages';
import previewHash from '~/data/resume-preview.sha256?raw';

// nginx caches images for 30 days; the PDF's hash in the URL makes a new CV
// reach phones on the next deploy.
const version = previewHash.trim().slice(0, 10);
---
<SiteLayout title="CV — Zack Low" description={pages.cv.description}>
  <section class="wrap head">
    <h1 class="t-64 title">{pages.cv.title}</h1>

    <div class="actions">
      <a href="/resume.pdf" class="btn" download="Ren Hwa Low resume.pdf">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12" /><path d="M6 11l6 6 6-6" /><path d="M5 21h14" />
        </svg>
        Download PDF
      </a>
      <a href="/resume.pdf" class="open t-17" target="_blank" rel="noopener">
        Open in new tab
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7" /><path d="M9 7h8v8" />
        </svg>
      </a>
    </div>
  </section>

  <section class="wrap viewer">
    {/* The <object> fallback only fires when the browser says it cannot render
        the type. Mobile Chrome says it can, then paints a black slab, so the
        fallback never appeared where it was needed most. So small screens get
        the page as a picture (scripts/resume-preview.sh), which opens the PDF. */}
    <object data="/resume.pdf#view=FitH" type="application/pdf" class="pdf" aria-label="CV, PDF">
      <div class="fallback">
        <p class="t-17">This browser can't preview the PDF.</p>
        <a href="/resume.pdf" class="btn" download>Download it instead</a>
      </div>
    </object>

    <div class="onsmall">
      <a href="/resume.pdf" class="page" target="_blank" rel="noopener" aria-label="Open the CV as a PDF">
        <img src={`/resume.webp?v=${version}`} width="1656" height="2339" alt="Page 1 of Ren Hwa Low's CV." loading="eager" decoding="async" />
      </a>
      <p class="t-14 hint">Tap the page to open the PDF and zoom.</p>
    </div>
  </section>
</SiteLayout>
<style>
  /* Was a bare row of right-aligned buttons with no heading at all, while
     pages.cv defined an eyebrow, a title and a lede that nothing imported. */
  .head { padding-block: var(--s-8) var(--s-5); }
  .lede { max-width: 30ch; margin-top: var(--s-4); }
  .actions {
    display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap;
    margin-top: var(--s-7);
  }
  .open { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-2); }
  .open:hover { color: var(--ink); }
  .open svg { transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1); }
  .open:hover svg { transform: translate(2px, -2px); }

  .viewer { padding-bottom: var(--s-11); }
  .pdf {
    width: 100%; max-width: 840px; margin-inline: auto; display: block;
    height: min(1180px, 140vh);
    border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--surface);
  }
  .fallback { display: grid; place-items: center; gap: var(--s-4); height: 100%; padding: var(--s-7); }

  .onsmall { display: none; }
  .page {
    display: block; overflow: hidden; background: #fff;
    border: 1px solid var(--border); border-radius: var(--radius-m);
  }
  .page img { width: 100%; height: auto; }
  .hint { margin-top: var(--s-4); text-align: center; color: var(--ink-3); }

  @media (max-width: 734px) {
    .pdf { display: none; }
    .onsmall { display: block; }
  }
</style>
