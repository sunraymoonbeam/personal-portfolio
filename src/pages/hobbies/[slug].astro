---
import { render } from 'astro:content';
import { articleComponents } from '~/components/article/mdx';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import Gallery from '~/components/article/Gallery.astro';
import { getPublishedHobbies, toArticleLinks, getAdjacent, keyOf } from '~/lib/content';

export async function getStaticPaths() {
  const entries = (await getPublishedHobbies()).filter((e) => e.data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = (await getPublishedHobbies()).filter((e) => e.data.writeup);
const links = toArticleLinks('hobbies', all).map((link, i) => ({ ...link, sub: all[i]!.data.summary }));
const { prev, next } = getAdjacent(links, keyOf('hobbies', entry.id));
---
<ArticleLayout
  title={d.title} summary={d.summary}
  quoteBy={d.quoteBy}
  backHref="/hobbies/" backLabel="All hobbies" prev={prev} next={next} noun="hobby"
>
  {/* No cover above the text: the article opens with words, and the cover
      photo appears in the body next to the paragraph it belongs to. */}

  {/* The rail lists every hobby, so the frame matches work and projects and
      the space beside the text is a way to wander, not a gap. */}
  <nav slot="aside" class="others" aria-label="Hobbies">
    <p class="t-14 h">Hobbies</p>
    <ol>
      {links.map((l) => (
        <li><a href={l.href} aria-current={l.key === keyOf('hobbies', entry.id) ? 'page' : undefined}>{l.title}</a></li>
      ))}
    </ol>
  </nav>

  <Content components={articleComponents} />
  <Gallery items={d.gallery} />
</ArticleLayout>
<style>
  .others { font-size: 14px; letter-spacing: -0.01em; }
  .h { color: var(--ink-2); font-weight: 500; margin-bottom: var(--s-3); }
  ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); display: flex; flex-direction: column; gap: 2px; }
  a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 1px solid transparent; color: var(--ink-3); }
  a:hover { color: var(--ink); }
  a[aria-current='page'] { color: var(--ink); border-left-color: var(--mark); }
</style>
