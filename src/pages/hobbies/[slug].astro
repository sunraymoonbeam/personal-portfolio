---
import { render } from 'astro:content';
import { articleComponents } from '~/components/article/mdx';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import Gallery from '~/components/article/Gallery.astro';
import { getPublishedHobbies, toArticleLinks, getAdjacent, keyOf } from '~/lib/content';
import { formatMonth } from '~/lib/date';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const entries = (await getPublishedHobbies()).filter((e) => e.data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = (await getPublishedHobbies()).filter((e) => e.data.writeup);
const { prev, next } = getAdjacent(toArticleLinks('hobbies', all), keyOf('hobbies', entry.id));
---
<ArticleLayout
  title={d.title} summary={d.summary} eyebrow={`Hobbies · ${formatMonth(d.published)}`}
  backHref="/hobbies" backLabel="All hobbies" prev={prev} next={next}
>
  {d.cover && (
    <figure slot="hero" class="cover">
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[720, 1200, 1600]}
             sizes="(max-width: 980px) 100vw, 980px" loading="eager" />
    </figure>
  )}

  <Content components={articleComponents} />
  <Gallery items={d.gallery} />
</ArticleLayout>
<style>
  .cover { margin: 0 0 var(--s-4); }
  .cover img { width: 100%; border-radius: var(--radius-l); aspect-ratio: 16 / 9; object-fit: cover; }
</style>
