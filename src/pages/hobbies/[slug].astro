---
import { render } from 'astro:content';
import { articleComponents } from '~/components/article/mdx';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import Gallery from '~/components/article/Gallery.astro';
import { getPublishedHobbies, toArticleLinks, getAdjacent, keyOf } from '~/lib/content';

export async function getStaticPaths() {
  const entries = (await getPublishedHobbies()).filter((e) => e.data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = (await getPublishedHobbies()).filter((e) => e.data.writeup);
const links = toArticleLinks('hobbies', all).map((link, i) => ({ ...link, sub: all[i]!.data.summary }));
const { prev, next } = getAdjacent(links, keyOf('hobbies', entry.id));
---
<ArticleLayout
  title={d.title} summary={d.summary}
  quoteBy={d.quoteBy}
  backHref="/hobbies/" backLabel="All hobbies" prev={prev} next={next} noun="hobby"
>
  {/* No cover above the text: the article opens with words, and the cover
      photo appears in the body next to the paragraph it belongs to. */}

  <Content components={articleComponents} />
  <Gallery items={d.gallery} />
</ArticleLayout>
