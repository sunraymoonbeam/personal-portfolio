---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PlayGrid from '../../components/play/PlayGrid.astro';
import { getPlayIndex } from '../../lib/content';
import { pages } from '../../content/pages';
const items = await getPlayIndex();
---
<SiteLayout title="Play — Zack Low" description="Cooking, climbing, guitar, film.">
  <section class="section wrap intro measure-start">
    <p class="eyebrow">{pages.play.eyebrow}</p>
    <h1 class="t-64">{pages.play.title}</h1>
    <p class="t-21 muted">{pages.play.lede}</p>
  </section>
  <section class="wrap" style="padding-bottom: var(--s-11)"><PlayGrid items={items} /></section>
</SiteLayout>
<style>.intro { display: flex; flex-direction: column; gap: var(--s-4); }</style>
