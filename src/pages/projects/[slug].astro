---
import { render } from 'astro:content';
import { articleComponents } from '../../components/article/mdx';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Gallery from '../../components/article/Gallery.astro';
import ScreenshotFrame from '../../components/projects/ScreenshotFrame.astro';
import ProjectVisual from '../../components/projects/ProjectVisual.astro';
import TechChip from '../../components/ui/TechChip.astro';
import { getProjectArticles, toArticleLinks, getAdjacent, keyOf } from '../../lib/content';
import { formatMonth } from '../../lib/date';

export async function getStaticPaths() {
  const articles = await getProjectArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const links = toArticleLinks('projects', await getProjectArticles());
const { prev, next } = getAdjacent(links, keyOf('projects', entry.id));
---
{/* Same order as the reference detail page: date and status, the name, the
    one-line claim, the outbound links, the numbers, then the screenshot, and
    only then the write-up with "built with" alongside it. */}
<ArticleLayout
  title={d.title} summary={d.claim}
  eyebrow={d.status === 'Shipped' ? formatMonth(d.published) : `${formatMonth(d.published)} · ${d.status}`}
  backHref="/projects" backLabel="All projects"
  prev={prev} next={next}
>
  <div slot="head" class="head-bits">
    {(d.links?.repo || d.links?.live || d.links?.docs) && (
      <div class="out">
        {d.links?.live && <a href={d.links.live} class="act t-17" rel="noopener">Live</a>}
        {d.links?.repo && (
          <a href={d.links.repo} class="act t-17" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/></svg>
            Source
          </a>
        )}
        {d.links?.docs && <a href={d.links.docs} class="act t-17" rel="noopener">Docs</a>}
      </div>
    )}
    {d.metrics && (
      <div class="numbers">
        {d.metrics.map((m) => (
          <span class="metric">
            <span class="t-28 tabular">{m.value}</span>
            <span class="t-14 muted">{m.label}</span>
          </span>
        ))}
      </div>
    )}
  </div>

  <div slot="hero" class="hero">
    {d.cover ? <ScreenshotFrame title={d.title} src={d.cover} alt={d.coverAlt ?? ''} dim={d.coverDim} eager morph={`shot-${entry.id}`} /> : <ProjectVisual title={d.shortTitle ?? d.title} wide />}
  </div>

  <div slot="aside" class="facts">
    <div><span class="eyebrow">Built with</span>
      <ul class="tags">{d.stack.map((id) => <TechChip id={id} />)}</ul></div>
    {d.cardHighlights && (
      <div><span class="eyebrow">Highlights</span>
        <ul class="hl">{d.cardHighlights.map((h) => <li class="t-14 muted">{h}</li>)}</ul></div>
    )}
  </div>

  <p class="t-19 lead">{d.summary}</p>
  <Content components={articleComponents} />
  <Gallery items={d.gallery} />
</ArticleLayout>
<style>
  .head-bits { display: flex; flex-direction: column; gap: var(--s-5); }
  .out { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-5); }
  .act { display: inline-flex; align-items: center; gap: 8px; color: var(--link); }
  .numbers { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-7); }
  .metric { display: flex; align-items: baseline; gap: 8px; }

  .hero { margin: 0; padding-bottom: var(--s-4); }
  /* The long description opens the article rather than repeating in a box. */
  .lead { margin-bottom: var(--s-5); }

  .facts { display: flex; flex-direction: column; gap: var(--s-6); }
  .tags, .hl { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s-3); }
  .hl { flex-direction: column; gap: var(--s-2); list-style: disc; padding-left: 18px; }
</style>
