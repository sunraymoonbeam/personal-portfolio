---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectRow from '../../components/projects/ProjectRow.astro';
import { getPublishedProjects } from '../../lib/content';
import { pages } from '../../content/pages';
const projects = await getPublishedProjects();
---
<SiteLayout title="Projects — Zack Low" description="Side projects, shipped end to end.">
  <section class="section wrap intro">
    <p class="eyebrow">{pages.projects.eyebrow}</p>
    <h1 class="t-64">{pages.projects.title}</h1>
    <p class="t-21 muted">{pages.projects.lede}</p>
  </section>
  <section class="wrap list">
    {projects.map((entry, i) => <ProjectRow entry={entry} index={i} />)}
  </section>
</SiteLayout>
<style>
  .intro { display: flex; flex-direction: column; gap: var(--s-4); max-width: 760px; }
  .list { display: flex; flex-direction: column; gap: var(--s-11); padding-bottom: var(--s-11); }
</style>
