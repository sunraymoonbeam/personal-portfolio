---
import { Image } from 'astro:assets';
import portrait from '~/assets/portrait.jpg';
import SiteLayout from '~/layouts/SiteLayout.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import CrayonWord from '~/components/site/CrayonWord.astro';
import HobbyGrid from '~/components/hobbies/HobbyGrid.astro';
import { getFeaturedHobbies } from '~/lib/content';
import { pages } from '~/copy/pages';

const hobbies = await getFeaturedHobbies(4);
const a = pages.about;
---
{/* Reference shape: portrait and a facts table in a narrow left column, the
    name and the long version beside it. */}
<SiteLayout title="About — Zack Low" description={a.lede}>
  <section class="section wrap">
    <p class="eyebrow">{a.eyebrow}</p>

    <div class="cols">
      <div class="side">
        <div class="portrait">
          <Image src={portrait} alt="Ren Hwa (Zack) Low" widths={[400, 700, 1000]}
                 sizes="(max-width: 900px) 70vw, 340px" loading="eager" />
        </div>
        <dl class="facts">
          {a.facts.map((f) => (
            <div class="fact">
              <dt class="eyebrow bare">{f.k}</dt>
              <dd class="t-14">{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="main">
        <h1 class="t-64">{a.title}</h1>
        <div class="actions">
          <a href="/cv/" class="btn">CV</a>
          <a href="/contact/" class="btn btn-ghost">Contact</a>
        </div>

        <blockquote class="bio rise">
          <p>I studied Computer Science at NTU, mostly doing web development. A few analytics projects got me interested in data, and by graduation I was choosing between data engineering and AI. I picked AI.</p>
          <p>Before graduating I'd already tried a bit of it: LLM tools at the Department of Statistics and speech processing at NIE. Then I joined AI Singapore, where we built a model that turns text into 3D animation for a game company. Seeing it change how their developers worked is when I realised what I enjoy most: building systems that solve a real problem, especially when there's data involved. Now I build AI agents at Carro.</p>
          <p>I specialise in AI, but I think of myself as a software engineer first. You can't build a good model without good data, and someone has to set up the database, the pipeline and the deployment around it. I'm happy to be that person.</p>
          <p>I actually like running into bugs, because that's where I learn how a system really works. I zoom out to see how the parts connect, then zoom in on the one that failed.</p>
          <p>Outside work I climb, cook for my family, make too much coffee and play guitar badly.</p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section"><div class="wrap">
    <SectionHead href="/hobbies/" linkLabel="View all hobbies">
      <CrayonWord slot="title" />
    </SectionHead>
    <HobbyGrid items={hobbies} />
  </div></section>
</SiteLayout>
<style>
  .cols {
    display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: var(--s-10); align-items: start; margin-top: var(--s-7);
  }
  .side { display: flex; flex-direction: column; gap: var(--s-6); }
  .portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-l); }

  /* A small table of the things people scan for first. */
  .facts { border-top: 1px solid var(--border); }
  .fact {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--s-4); padding-block: 11px; border-bottom: 1px solid var(--border);
  }
  .fact dd { margin: 0; text-align: right; }

  .main { display: flex; flex-direction: column; }
  .actions { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-6); }

  /* The whole bio is the quote, so the rule runs its full height. */
  .bio {
    display: flex; flex-direction: column; gap: var(--s-5);
    max-width: 62ch; margin: var(--s-10) 0 0;
    padding-left: var(--s-6); border-left: 1px solid var(--border-strong);
  }
  .bio p { font-size: 19px; line-height: 1.55; letter-spacing: -0.02em; color: var(--ink); }

  /*
   * Stacked, the left column came first, so a phone showed a photograph and a
   * table of facts before the reader knew whose they were. Order the DOM for
   * reading and let the grid place them on a wide screen instead.
   */
  /* …but with the photo after the whole bio, a phone never put a face to the
     name. The main column dissolves into the grid so the portrait and facts
     slot in after the buttons, before the long version. */
  @media (max-width: 900px) {
    .cols { display: flex; flex-direction: column; gap: 0; }
    .main { display: contents; }
    .side { max-width: 320px; order: 1; margin-top: var(--s-8); }
    .bio { order: 2; margin-top: var(--s-9); }
  }
  @media (max-width: 600px) { .bio { padding-left: var(--s-4); } .side { max-width: none; } }
</style>
