---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import TechChip from '../components/ui/TechChip.astro';
import PlayGrid from '../components/play/PlayGrid.astro';
import { STACK_GROUPS } from '../data/technologies';
import { getPlayIndex } from '../lib/content';
import { pages } from '../content/pages';

const play = (await getPlayIndex()).slice(0, 4);
---
<SiteLayout title="About — Zack Low" description={pages.about.lede}>
  <section class="hero">
    <div class="copy wrap measure-start">
      <p class="eyebrow">{pages.about.eyebrow}</p>
      <h1 class="t-64">{pages.about.title}</h1>
      <p class="t-21 muted">{pages.about.lede}</p>
      <div class="actions">
        <a href="/resume" class="btn btn-dark">Résumé</a>
        <a href="/contact" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section"><div class="wrap prose">
    <p>I studied Computer Science at NTU. After working on analytics projects, I became interested in data and the systems that make it useful. I chose to explore AI at AI Singapore, but I describe myself as a software engineer specialising in data. Building a model also means understanding the database, the pipeline and the people who use the result.</p>
    <p>At AI Singapore I worked on a generative animation MVP for a gaming company. At NIE I worked on speech and signal processing for classroom discussions. At the Singapore Department of Statistics I prototyped LLM and text analytics tools. I now build agent workflows and their infrastructure at Carro.</p>
    <p>I enjoy finding the cause of a bug. I step back to understand the input, the expected result and the surrounding system, then work through a fix. I also care about explaining technical ideas clearly to teammates and stakeholders. Teaching others has made me check my own understanding.</p>
    <p>I have learned to keep priorities visible and to avoid polishing a small piece while the real problem waits. Outside work, I spend time climbing, cooking and enjoying coffee. There is more of that on <a href="/play">Play</a>.</p>
  </div></section>

  <section class="section band"><div class="wrap">
    <SectionHead title="Tools I use" sub="From the projects and roles described here." />
    <div class="groups">
      {STACK_GROUPS.map((g) => (
        <div class="group">
          <h3 class="t-21">{g.title}</h3>
          <ul class="chips">{g.items.map((id) => <TechChip id={id} />)}</ul>
        </div>
      ))}
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <SectionHead title="Play" sub="Climbing, coffee and cooking." href="/play" linkLabel="All three" />
    <PlayGrid items={play} />
  </div></section>
</SiteLayout>
<style>
  .hero { background: var(--surface); }
  .copy {
    display: flex; flex-direction: column; gap: var(--s-4); justify-content: center;
    padding-block: clamp(48px, 8vw, 120px);
  }
  .actions { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-2); }
  .groups { display: flex; flex-direction: column; }
  .group {
    display: grid; grid-template-columns: 200px 1fr; gap: var(--s-7);
    align-items: start; padding-block: var(--s-6); border-top: 1px solid var(--border);
  }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (max-width: 860px) {
    .group { grid-template-columns: 1fr; gap: var(--s-3); }
  }
</style>
