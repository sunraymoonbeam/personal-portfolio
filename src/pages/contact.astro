---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { site } from '~/config/site';
import { pages } from '~/copy/pages';

const githubHandle = site.socials.github.replace('https://', '');
---
{/* Two columns, as on the reference contact page: the ways to reach me on the
    left, the form on the right. The site is static, so the form has no server:
    it validates in the browser and then hands a pre-filled draft to the mail
    client. The address above it works on its own if scripting is off. */}
<SiteLayout title="Contact — Zack Low" description={pages.contact.lede.join(' ')}>
  <section class="section wrap">
    <h1 class="t-64 title">{pages.contact.title}</h1>

    <div class="cols">
      <div class="left">
        <blockquote class="lede">
          {pages.contact.lede.map((line) => <p class="t-19">{line}</p>)}
        </blockquote>

        {/* The address opens a mail app; the button beside it copies it, for
            everyone whose mail lives in a browser tab. */}
        <div class="mailrow">
          <a href={`mailto:${site.email}`} class="t-24 mail">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" />
            </svg>
            {site.email}
          </a>
          <button type="button" class="copy" data-copy={site.email} hidden>
            <svg class="i-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
            <svg class="i-done" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            <span data-copy-label>Copy</span>
          </button>
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
        </div>

        <ul class="rows">
          <li>
            <a href={site.socials.github} rel="me noopener" aria-label={`GitHub, ${githubHandle}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/></svg>
              {githubHandle}
            </a>
          </li>
          <li>
            <a href={site.socials.linkedin} rel="me noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.3ZM5.3 7.4a2.1 2.1 0 1 1 0-4.1 2.1 2.1 0 0 1 0 4.1ZM7.1 20.5H3.6V9h3.5v11.5ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6C0 23.2.8 24 1.8 24h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0Z"/></svg>
              {site.fullName}
            </a>
          </li>
          <li class="where">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
            </svg>
            {site.location}, GMT+8
          </li>
        </ul>
      </div>

      <form class="form" novalidate data-contact>
        <div class="pair">
          <p class="field">
            <label for="name">Name</label>
            <input id="name" name="name" autocomplete="name" placeholder="Jane Doe…" required />
            <span class="err" id="err-name" role="alert" hidden></span>
          </p>
          <p class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email"
                   placeholder="jane@company.com…" required />
            <span class="err" id="err-email" role="alert" hidden></span>
          </p>
        </div>

        <p class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required
                    placeholder="Hey Zack, I came across your site and wanted to talk…"></textarea>
          <span class="err" id="err-message" role="alert" hidden></span>
        </p>

        {/* Honeypot: a real person never fills this in. */}
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="trap" />

        <div class="send">
          <button type="submit" class="btn">
            Send message
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </button>
          <span class="t-14 muted status" role="status" aria-live="polite" data-status></span>
        </div>

        <p class="t-12 small note">
          This opens a draft in your mail app, addressed to me. No form data
          leaves your machine until you press send there.
        </p>
      </form>
    </div>
  </section>
</SiteLayout>

<script>
  // Copy needs the async clipboard API; where it is missing the button stays
  // hidden and the mailto link is the whole story.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn && navigator.clipboard) {
    btn.hidden = false;
    const label = btn.querySelector('[data-copy-label]')!;
    const status = document.querySelector('[data-copy-status]')!;
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.dataset.done = '';
        label.textContent = 'Copied';
        status.textContent = 'Email address copied.';
        clearTimeout(timer);
        timer = window.setTimeout(() => { delete btn.dataset.done; label.textContent = 'Copy'; status.textContent = ''; }, 2000);
      } catch {
        label.textContent = 'Press ⌘C';
      }
    });
  }
</script>
<script is:inline define:vars={{ address: site.email }}>
  const form = document.querySelector('[data-contact]');
  if (form) {
    const status = form.querySelector('[data-status]');
    const show = (id, msg) => {
      const el = form.querySelector('#err-' + id);
      const input = form.querySelector('#' + id);
      if (!el || !input) return;
      el.textContent = msg ?? '';
      el.hidden = !msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      input.setAttribute('aria-describedby', msg ? 'err-' + id : '');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const name = String(data.name ?? '').trim();
      const email = String(data.email ?? '').trim();
      const message = String(data.message ?? '').trim();

      show('name', name ? '' : 'What should I call you?');
      show('email', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? '' : 'Enter a valid email so I can reply.');
      show('message', message ? '' : 'Add a line or two.');

      const firstBad = form.querySelector('[aria-invalid="true"]');
      if (firstBad) { status.textContent = ''; firstBad.focus(); return; }

      // Honeypot tripped: say nothing happened, and do nothing.
      if (String(data.company ?? '')) { status.textContent = 'Thanks.'; return; }

      const body = message + '\n\n--\n' + name + '\n' + email;
      window.location.href =
        'mailto:' + address +
        '?subject=' + encodeURIComponent('Hello from ' + name) +
        '&body=' + encodeURIComponent(body);
      status.textContent = 'Opening your mail app.';
    });
  }
</script>

<style>
  .title { margin-top: var(--s-4); max-width: 14ch; }
  .cols {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-10); margin-top: var(--s-9); align-items: start;
  }
  .left { display: flex; flex-direction: column; gap: var(--s-6); }
  .lede {
    display: flex; flex-direction: column; gap: var(--s-4);
    max-width: 44ch; margin: 0;
    padding-left: var(--s-5); border-left: 1px solid var(--border-strong);
  }
  .lede p { color: var(--ink); }

  .mailrow { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-3) var(--s-4); }
  .mail { display: inline-flex; align-items: center; gap: var(--s-3); font-weight: 600; overflow-wrap: anywhere; }
  .copy {
    display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px;
    border: 1px solid var(--border); border-radius: var(--radius-pill); background: var(--subtle);
    color: var(--ink-2); font: inherit; font-size: 14px; cursor: pointer; touch-action: manipulation;
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .copy[hidden] { display: none; }
  .copy:hover { border-color: var(--border-strong); color: var(--ink); }
  .copy:active { transform: scale(0.97); }
  .copy .i-done { display: none; }
  .copy[data-done] { color: var(--link); border-color: var(--link); }
  .copy[data-done] .i-copy { display: none; }
  .copy[data-done] .i-done { display: block; }
  @media (prefers-reduced-motion: reduce) { .copy:active { transform: none; } }
  .mail svg { color: var(--link); flex-shrink: 0; }

  .rows { display: flex; flex-direction: column; gap: var(--s-1); font-size: 15px; letter-spacing: -0.01em; }
  .rows a, .where { display: inline-flex; align-items: center; gap: var(--s-3); min-height: 36px; }
  .rows svg { color: var(--ink-3); flex-shrink: 0; transition: color 200ms ease; }
  .rows a:hover svg { color: var(--link); }
  .where { color: var(--ink-2); }
  @media (pointer: coarse) { .rows a { min-height: 44px; } }

  /* ── form ── */
  .form { display: flex; flex-direction: column; gap: var(--s-5); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .field { display: flex; flex-direction: column; gap: var(--s-2); margin: 0; }
  label { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink-2); }
  input, textarea {
    width: 100%; padding: 12px 14px; font: inherit; font-size: 16px;
    color: var(--ink); background: var(--subtle);
    border: 1px solid var(--border); border-radius: var(--radius-s);
    transition: border-color 160ms ease;
  }
  textarea { resize: vertical; min-height: 140px; }
  input::placeholder, textarea::placeholder { color: var(--control); }
  input:focus, textarea:focus { outline: none; border-color: var(--focus); }
  [aria-invalid='true'] { border-color: var(--mark); }
  .err { font-size: 13px; color: var(--mark); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; }

  .send { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
  .btn svg { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .btn:hover svg { transform: translateX(3px); }
  .note { max-width: 46ch; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; gap: var(--s-8); }
  }
  @media (max-width: 560px) { .pair { grid-template-columns: 1fr; } }
</style>
