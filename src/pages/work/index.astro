---
import SiteLayout from '~/layouts/SiteLayout.astro';
import WorkList from '~/components/work/WorkList.astro';
import { getWorkRows, resolveWork } from '~/lib/content';
import { pages } from '~/copy/pages';

const rows = await Promise.all((await getWorkRows()).map(resolveWork));
---
<SiteLayout title="Work — Zack Low" description={pages.work.lede}>
  <section class="section wrap intro">
    <h1 class="t-64">{pages.work.title}</h1>
    <p class="t-19 muted body">{pages.work.lede}</p>
  </section>

  <section class="wrap list">
    <WorkList rows={rows} headingLevel={2} />
  </section>
</SiteLayout>
<style>
  .intro { display: flex; flex-direction: column; gap: var(--s-4); }
  .intro h1 { max-width: 760px; }
  .intro .body { max-width: 66ch; }
  .list { padding-bottom: var(--s-11); }
</style>
