---
import { render, getEntry } from 'astro:content';
import { articleComponents } from '~/components/article/mdx';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import Gallery from '~/components/article/Gallery.astro';
import { getWorkArticles, toArticleLinks, getAdjacent, keyOf } from '~/lib/content';
import { formatRange, formatDuration } from '~/lib/date';
import { Image } from 'astro:assets';

// Only entries with writeup: true get a route. Drafts and no-writeup roles
// generate nothing — the policy lives in one place and routes obey it.
export async function getStaticPaths() {
  const articles = await getWorkArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const employer = await getEntry(d.employer);
const { Content } = await render(entry);
const links = toArticleLinks('work', await getWorkArticles());
const { prev, next } = getAdjacent(links, keyOf('work', entry.id));
---
<ArticleLayout
  title={d.title} summary={d.summary}
  eyebrow={`${employer.data.name} · ${d.role} · ${formatRange(d.start, d.end)}`}
  backHref="/work" backLabel="All work experience"
  prev={prev} next={next}
>
  {d.cover && (
    <figure slot="hero" class="cover">
      <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[720, 1200, 1600]}
             sizes="(max-width: 980px) 100vw, 980px" loading="eager" />
    </figure>
  )}

  <dl slot="aside" class="facts">
    <div><dt class="eyebrow bare">Role</dt><dd class="t-14">{d.role} · {d.kind}</dd></div>
    <div><dt class="eyebrow bare">When</dt><dd class="t-14 tabular">{formatRange(d.start, d.end)} · {formatDuration(d.start, d.end)}</dd></div>
    <div><dt class="eyebrow bare">Where</dt><dd class="t-14">{d.location}</dd></div>
    {d.metrics && (
      <div><dt class="eyebrow">Outcome</dt>
        <dd class="metrics">{d.metrics.map((m) => (
          <span class="metric"><span class="t-28 tabular">{m.value}</span><span class="t-14 muted">{m.label}</span>{m.context && <span class="t-14 small">{m.context}</span>}</span>
        ))}</dd>
      </div>
    )}
  </dl>
  <div class="result">
    <span class="eyebrow">In short</span>
    <p class="t-19">{d.summary}</p>
  </div>

  <Content components={articleComponents} />
  <Gallery items={d.gallery} />
</ArticleLayout>
<style>
  .cover { margin: 0 0 var(--s-4); }
  .cover img { width: 100%; border-radius: var(--radius-l); aspect-ratio: 16 / 9; object-fit: cover; }
  .facts { display: flex; flex-direction: column; gap: var(--s-5); }
  .result {
    padding: var(--s-5); border-radius: var(--radius-m);
    background: var(--surface); margin-bottom: var(--s-6);
    display: flex; flex-direction: column; gap: var(--s-2);
  }
  .facts dd { margin: 0; margin-top: 6px; }
  .metrics { display: flex; flex-direction: column; gap: var(--s-3); }
  .metric { display: flex; flex-direction: column; }
</style>
